# =============================================================================
# CraftLink - environment variables
# 1) cp .env.example .env     2) edit the values marked CHANGE     3) NEVER commit .env
# Variables are validated at start-up by backend/src/config/env.ts
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=craftlink
POSTGRES_PASSWORD=CHANGE-me-locally
POSTGRES_DB=craftlink
DB_PORT=5432

# Used when the backend runs on YOUR machine (npm run start:dev).
# In Docker, docker-compose.yml builds the URL itself (host "db").
DATABASE_URL=postgresql://craftlink:CHANGE-me-locally@localhost:5432/craftlink?schema=public

# ---- Backend ----
NODE_ENV=development
PORT=3000
# CHANGE: generate one with  openssl rand -base64 48
JWT_SECRET=CHANGE-me-with-a-long-random-string
JWT_EXPIRES_IN=1d
COOKIE_NAME=craftlink_token
# false for plain-http local development (Vite on :5173). Docker forces true (HTTPS).
COOKIE_SECURE=false
APP_URL=https://localhost:8443
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# Inserts demo accounts and data at start-up (idempotent). Set to false in a real deployment.
SEED_ON_START=true

# ---- OAuth (GitHub OAuth app: https://github.com/settings/developers) ----
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---- Docker entry point ----
HTTPS_PORT=8443
