// =============================================================================
// CraftLink - database schema (PostgreSQL)
//
// OWNER: Tech Lead. Any change to this file goes through a dedicated pull request
// (type "feat(db): ..." or "fix(db): ...") reviewed by the Tech Lead, together with
// the generated migration. Never edit a migration that is already on `main`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  CRAFTSMAN
  ADMIN
}

enum Language {
  EN
  FR
  ES
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PriceType {
  HOURLY
  FIXED
}

enum ModerationStatus {
  VISIBLE
  HIDDEN
}

enum ModerationTarget {
  LISTING
  REVIEW
}

enum ModerationActionType {
  HIDE
  RESTORE
  DELETE
}

enum FileKind {
  AVATAR
  PORTFOLIO
  REQUEST_PHOTO
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum NotificationType {
  REQUEST_CREATED
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  STATUS_CHANGED
  REVIEW_RECEIVED
  LISTING_MODERATED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_MESSAGE
}

// ----------------------------------------------------------------------------
// Accounts
// ----------------------------------------------------------------------------

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  /// null for accounts created only through OAuth
  passwordHash      String?
  role              Role          @default(CUSTOMER)
  displayName       String
  phone             String?
  preferredLanguage Language      @default(EN)
  status            AccountStatus @default(ACTIVE)
  /// updated when the user disconnects from the realtime gateway
  lastSeenAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  craftsmanProfile  CraftsmanProfile?
  oauthAccounts     OAuthAccount[]
  requestsAsCustomer ServiceRequest[]       @relation("RequestCustomer")
  reviewsWritten    Review[]
  friendshipsSent   Friendship[]            @relation("FriendshipRequester")
  friendshipsReceived Friendship[]          @relation("FriendshipAddressee")
  conversationsAsA  Conversation[]          @relation("ConversationUserA")
  conversationsAsB  Conversation[]          @relation("ConversationUserB")
  messagesSent      Message[]
  notifications     Notification[]
  files             FileAsset[]
  statusChanges     RequestStatusHistory[]
  moderationActions ModerationAction[]

  @@map("users")
}

model OAuthAccount {
  id             String @id @default(uuid())
  userId         String
  provider       String // "github", "google"
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model CraftsmanProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  bio           String?
  city          String
  latitude      Float?
  longitude     Float?
  isAvailable   Boolean  @default(true)
  /// denormalized: recomputed every time a review is created, edited or hidden
  averageRating Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings ServiceListing[]
  requests ServiceRequest[]

  @@index([city])
  @@map("craftsman_profiles")
}

model Trade {
  id       String @id @default(uuid())
  /// stable key also used as translation key (e.g. "plumbing" -> trades.plumbing)
  slug     String @unique

  listings ServiceListing[]

  @@map("trades")
}

model ServiceListing {
  id               String           @id @default(uuid())
  craftsmanId      String
  tradeId          String
  title            String
  description      String
  priceType        PriceType
  basePrice        Decimal          @db.Decimal(10, 2)
  isActive         Boolean          @default(true)
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  craftsman CraftsmanProfile @relation(fields: [craftsmanId], references: [id], onDelete: Cascade)
  trade     Trade            @relation(fields: [tradeId], references: [id])
  requests  ServiceRequest[]
  files     FileAsset[]

  @@index([tradeId, isActive])
  @@index([craftsmanId])
  @@map("service_listings")
}

// ----------------------------------------------------------------------------
// Requests and reviews
// ----------------------------------------------------------------------------

model ServiceRequest {
  id            String        @id @default(uuid())
  customerId    String
  craftsmanId   String
  listingId     String
  title         String
  description   String
  address       String
  city          String
  preferredDate DateTime?
  status        RequestStatus @default(PENDING)
  agreedPrice   Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?

  customer      User                   @relation("RequestCustomer", fields: [customerId], references: [id])
  craftsman     CraftsmanProfile       @relation(fields: [craftsmanId], references: [id])
  listing       ServiceListing         @relation(fields: [listingId], references: [id])
  history       RequestStatusHistory[]
  review        Review?
  photos        FileAsset[]
  notifications Notification[]

  @@index([customerId, createdAt])
  @@index([craftsmanId, status])
  @@map("service_requests")
}

model RequestStatusHistory {
  id         String         @id @default(uuid())
  requestId  String
  fromStatus RequestStatus?
  toStatus   RequestStatus
  changedById String
  changedAt  DateTime       @default(now())

  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User           @relation(fields: [changedById], references: [id])

  @@index([requestId, changedAt])
  @@map("request_status_history")
}

model Review {
  id               String           @id @default(uuid())
  requestId        String           @unique
  authorId         String
  /// 1 to 5, checked in the DTO and by a database constraint added in the migration
  rating           Int
  comment          String?
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt        DateTime         @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id])

  @@map("reviews")
}

// ----------------------------------------------------------------------------
// Social: friends and chat
// ----------------------------------------------------------------------------

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

/// One conversation per pair of users. Convention: userAId < userBId (sorted as strings)
/// so the pair is unique whatever the order in which the users start the chat.
model Conversation {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  sentAt         DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

// ----------------------------------------------------------------------------
// Notifications and files
// ----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  /// stored as parameters, never as text, so the frontend can translate it
  params    Json             @default("{}")
  requestId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@map("notifications")
}

model FileAsset {
  id        String   @id @default(uuid())
  ownerId   String
  kind      FileKind
  /// path relative to UPLOAD_DIR
  path      String
  mimeType  String
  sizeBytes Int
  listingId String?
  requestId String?
  createdAt DateTime @default(now())

  owner   User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing ServiceListing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  request ServiceRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([ownerId, kind])
  @@map("file_assets")
}

// ----------------------------------------------------------------------------
// Administration
// ----------------------------------------------------------------------------

model ModerationAction {
  id         String               @id @default(uuid())
  adminId    String
  targetType ModerationTarget
  targetId   String
  action     ModerationActionType
  reason     String?
  createdAt  DateTime             @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([targetType, targetId])
  @@map("moderation_actions")
}
